# ── SignSpeak AI · PRODUCTION environment template ─────────────
# Copy to /opt/signspeak/.env on the server and fill REAL values.
# NEVER commit the real .env — this file is the safe.
# Generate: with  openssl rand -hex 32

# ── Infrastructure ────────────────────────────────────────────
NODE_ENV=production
GIT_REPO=https://github.com/<owner>/<repo>.git
DOMAIN=signspeak.example.com
ADMIN_EMAIL=ops@signspeak.example.com
CLIENT_ORIGIN=https://signspeak.example.com

# ── MongoDB Atlas ─────────────────────────────────────────────
# Cluster → Database Access (user) → Network Access (0.0.0.0/0 or
# your VPS IP) → Connect → Drivers → paste the URI below.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/signspeak?retryWrites=true&w=majority

# ── Gateway secrets (openssl rand -hex 32) ────────────────────
JWT_ACCESS_SECRET=<32-byte-hex>
JWT_REFRESH_SECRET=<32-byte-hex>
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
VERIFY_TOKEN_TTL=1h
RESET_TOKEN_TTL=15m
REQUIRE_EMAIL_VERIFICATION=true

# ── SMTP (Gmail App Password works) ───────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=no-reply@signspeak.example.com
SMTP_PASS=<app-password>

# ── AI service (docker path only — bare metal reads ai-service/.env) ──
AI_MODEL_WINDOW=12
AI_CONFIDENCE_THRESHOLD=0.55
AI_SMOOTHING_ALPHA=0.6

# ── Admin bootstrap (production) ─────────────────────────────
# Default admin (admin@signspeak.ai) is NEVER created on boot in prod;
# set SEED_ADMIN=true for the very first deploy, replace the password
# immediately, then flip it back off.
# SEED_ADMIN=true

# ── Cloudinary (optional — the day avatar / gesture-video uploads land) ──
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=