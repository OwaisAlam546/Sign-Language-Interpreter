# ── SignSpeak AI inference service — copy to .env and edit ──
AI_HOST=0.0.0.0
AI_PORT=8000
AI_MODEL_DIR=models
TTS_ENGINE=tone          # tone (offline) | gtts (needs gTTS + internet)
TTS_LANG=en
CORS_ORIGINS=*
LOG_LEVEL=INFO
CAMERA_INDEX=0
# ── Phase 8: TensorFlow inference tuning ──────────────────────
AI_MODEL_WINDOW=12            # LSTM sequence length (frames per window)
AI_CONFIDENCE_THRESHOLD=0.55  # below this softmax peak → UNKNOWN
AI_SMOOTHING_ALPHA=0.6        # EMA weight for streamed prediction smoothing