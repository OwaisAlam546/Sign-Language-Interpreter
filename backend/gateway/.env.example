# ── SignSpeak AI · API Gateway — environment template ─────────
# Copy this file to `.env` and fill in real values.
# NEVER commit the real .env (it is gitignored).

# Runtime
NODE_ENV=development
PORT=5000

# Empty MONGO_URI = automatic in-memory MongoDB (zero setup for demos).
# Set a real URI (local Mongo or Atlas) for persistent data.
MONGO_URI=

# ── JWT ───────────────────────────────────────────────────────
# Generate real values in production, e.g. `openssl rand -hex 32`
JWT_ACCESS_SECRET=change-me-long-random-string
JWT_REFRESH_SECRET=change-me-long-random-string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
VERIFY_TOKEN_TTL=1h
RESET_TOKEN_TTL=15m

# Require email verification before login (true in production automatically).
REQUIRE_EMAIL_VERIFICATION=false

# ── CORS ──────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CLIENT_URL=http://localhost:5173

# ── AI inference service (Phase 9 bridge) ─────────────────────
AI_SERVICE_URL=http://localhost:8000
AI_TIMEOUT_MS=8000

# ── Email (SMTP) ──────────────────────────────────────────────
# Leave SMTP_USER/SMTP_PASS empty → dev preview mode: emails are
# printed to the server console instead of sent (zero setup).
# Gmail example: SMTP_USER=you@gmail.com + an App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="SignSpeak AI" <no-reply@signspeak.ai>
