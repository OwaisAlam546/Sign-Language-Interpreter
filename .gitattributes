# ── line-ending policy ──────────────────────────────────────────
# Windows dev box, Linux VPS target. Shell scripts must reach the
# server with LF or bash chokes on \r. Repo stores LF everywhere;
# Git converts on checkout as needed.
* text=auto

*.sh  text eol=lf
*.py  text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.conf text eol=lf
*.env.production text eol=lf